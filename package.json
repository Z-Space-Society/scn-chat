{
  "name": "scn-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter @scn-chat/server dev",
    "dev:remote": "pnpm --filter @scn-chat/server dev:remote",
    "build": "pnpm --filter @scn-chat/web build",
    "start": "pnpm --filter @scn-chat/server start",
    "preview": "pnpm build && pnpm start",
    "preview:remote": "pnpm build && pnpm --filter @scn-chat/server start:remote",
    "test": "vitest run",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "codegen": "pnpm --filter @scn-chat/lexicons codegen",
    "publish-lexicons": "pnpm --filter @scn-chat/lexicons publish-lexicons",
    "migrate": "pnpm --filter @scn-chat/server migrate",
    "keys": "pnpm --filter @scn-chat/server keys"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "24.19.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "@scn-chat/plugin-anthropic": "workspace:*",
    "@scn-chat/plugin-api": "workspace:*",
    "@scn-chat/plugin-google": "workspace:*",
    "@scn-chat/plugin-openai": "workspace:*",
    "@scn-chat/plugin-openai-compatible": "workspace:*",
    "@scn-chat/plugin-pdf-text": "workspace:*",
    "@scn-chat/plugin-scn-member-registry": "workspace:*",
    "@scn-chat/plugin-titles": "workspace:*",
    "@scn-chat/plugin-web-fetch": "workspace:*",
    "@scn-chat/plugin-web-search": "workspace:*"
  }
}
