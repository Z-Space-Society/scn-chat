{
  "lexicon": 1,
  "id": "network.sharedcomputer.chat.preferences",
  "defs": {
    "main": {
      "type": "record",
      "key": "literal:self",
      "record": {
        "type": "object",
        "properties": {
          "defaultModel": { "type": "ref", "ref": "network.sharedcomputer.chat.defs#modelRef" },
          "defaultEffort": { "type": "ref", "ref": "network.sharedcomputer.chat.defs#effort" },
          "customInstructions": {
            "type": "string",
            "maxLength": 100000,
            "description": "Added to the system prompt for each conversation."
          },
          "generateTitles": { "type": "boolean", "default": true },
          "timezone": {
            "type": "string",
            "maxLength": 100,
            "description": "IANA time zone name, such as America/Vancouver, for the date given to the model."
          },
          "updatedAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
