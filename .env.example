# SCN Chat bootstrap settings and secrets.

NODE_ENV=development
DATABASE_URL=sqlite:./data/scn-chat.sqlite

# Generate both with: pnpm keys
SECRET_KEY=
OAUTH_PRIVATE_KEYS=
# Retired secret keys, comma-separated, kept only to decrypt older values.
SECRET_KEYS_OLD=

# Comma-separated hardcoded admin list. Required.
ADMIN_DIDS=

# The URL people reach the app at. HTTPS in production.
PUBLIC_URL=http://127.0.0.1:3000
PORT=3000
DATA_DIR=./data
LOG_LEVEL=info

# permission-set, or raw to test the local fallback before the lexicons are published.
# Production refuses raw.
OAUTH_SCOPE_MODE=raw
PLC_URL=https://plc.directory
# Let the server reach PDSes and DID documents on private networks, for a local PDS.
ALLOW_PRIVATE_NETWORKS=false
