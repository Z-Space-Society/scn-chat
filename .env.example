# Secrets for SCN Chat. Public settings live in config.yml.

NODE_ENV=development
DATABASE_URL=sqlite:./data/scn-chat.sqlite

# Generate both with: pnpm keys
SECRET_KEY=
OAUTH_PRIVATE_KEYS=
# Retired secret keys, comma-separated, kept only to decrypt older values.
SECRET_KEYS_OLD=

# Admin API keys, referenced from config.yml.
SCN_API_KEY=
COCORE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional: point at a config file other than ./config.yml.
SCN_CHAT_CONFIG=
